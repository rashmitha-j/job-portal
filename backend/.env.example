PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/job-portal
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Resume storage: "local" (disk, for development) or "gridfs" (MongoDB, use in production)
RESUME_STORAGE=local
# Optional, local driver only: folder for uploaded resumes (default: backend/uploads)
# UPLOAD_DIR=./uploads
